{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tie-dye-studio-gallery",
  "main": "index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://nascarjake.github.io,https://tyedye.jakedoesdev.com,http://127.0.0.1:5173,http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tie-dye-studio-gallery",
      "migrations_dir": "migrations",
      "database_id": "9ba02b42-1d7d-4f60-b512-6c5945ae6b9f",
    },
  ],
  "ratelimits": [
    {
      "name": "SUBMISSIONS",
      "namespace_id": "1925092501",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
}
